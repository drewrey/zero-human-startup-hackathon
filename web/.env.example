# Claude, used for speech understanding. Optional: falls back to keyword parsing.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# UNDERSTAND_MODE=auto

# Apify: live eBay sold comps. Without it, demo data is used.
APIFY_TOKEN=
# COMPS_SOURCE=demo
# Postgres for the price index (InstaCloud). Optional locally.
# DATABASE_URL=
# APIFY_DAILY_BUDGET_USD=3
# Claude via Kylon credits instead of a direct key:
# ANTHROPIC_BASE_URL=https://api.kylon.io/proxy/anthropic
